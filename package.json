{
  "name": "solix-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Solix — a solar-system command center for Claude Code agents",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "dev:server": "pnpm --filter @solix/server dev",
    "dev:web": "pnpm --filter @solix/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
